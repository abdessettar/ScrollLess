# Copy to .env and fill in. .env is git-ignored; never commit it.

# LLM provider (the key matching summarization.provider in your config)
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# SMTP. For Gmail, enable 2FA and create an App Password at
# https://myaccount.google.com/apppasswords (remove the spaces).
# Microsoft personal accounts do not work: they no longer allow basic auth.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Reddit OAuth, only needed with `access: oauth` (the default rss mode needs
# nothing). Create a "script" app at https://www.reddit.com/prefs/apps.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=linux:scrollless:0.1.0 (by /u/your_reddit_username)
