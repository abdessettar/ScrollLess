{#
  Digest email.

  - Core styling is inline because several mail clients drop <style> blocks.
  - The <style> block only holds dark mode and narrow-screen rules, with
    !important so they override the inline styles.
  - Single column, no flex or grid, for Outlook's Word-based renderer.
  - No text labels: the counterpoint and takeaway are marked visually, so
    summaries in other languages do not get English captions.
#}
{%- set BODY_BG = "#f5f6f8" -%}
{%- set CARD_BG = "#ffffff" -%}
{%- set INK = "#16181d" -%}
{%- set MUTED = "#667085" -%}
{%- set RULE = "#e6e8ec" -%}
{%- set LINK = "#1d4ed8" -%}
{%- macro item_block(item) -%}
{%- set p = item.post -%}
{%- set s = item.summary -%}
<div class="item" style="padding:20px 0 4px;border-top:1px solid {{ RULE }};">
  <a class="title" href="{{ p.external_url or p.url }}" style="color:{{ INK }};font-size:17px;font-weight:600;line-height:1.35;text-decoration:none;display:block;margin-bottom:6px;">{{ p.title }}</a>
  <div class="byline" style="color:{{ MUTED }};font-size:13px;margin-bottom:12px;">
    {% if p.external_domain %}
    <span class="domain">{{ p.external_domain }}</span> · <a class="quiet-link" href="{{ p.url }}" style="color:{{ MUTED }};text-decoration:underline;">discussion</a>
    {% else %}
    <a class="quiet-link" href="{{ p.url }}" style="color:{{ MUTED }};text-decoration:underline;">discussion on {{ p.channel_label }}</a>
    {% endif %}
    {% if not p.score_is_estimated %}
    · {{ p.score }} points · {{ p.num_comments }} comments
    {% endif %}
  </div>
  {% if s.fallback_text %}
  <div class="gist" style="color:{{ INK }};font-size:15px;line-height:1.6;white-space:pre-wrap;margin:0 0 12px;">{{ s.fallback_text }}</div>
  {% else %}
  {% if s.gist %}
  <p class="gist" style="color:{{ INK }};font-size:15px;line-height:1.6;margin:0 0 12px;">{{ s.gist }}</p>
  {% endif %}
  {% if s.points %}
  <ul class="points" style="color:{{ INK }};font-size:15px;line-height:1.6;margin:0 0 12px;padding-left:20px;">
    {% for point in s.points %}
    <li style="margin-bottom:7px;">{{ point }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if s.dissent %}
  <div class="dissent" style="border-left:3px solid #d97706;background:#fffbeb;color:#5c4813;font-size:14px;line-height:1.6;padding:10px 14px;margin:0 0 12px;border-radius:0 4px 4px 0;">{{ s.dissent }}</div>
  {% endif %}
  {% if s.takeaway %}
  <div class="takeaway" style="color:#0f766e;font-size:14px;line-height:1.55;margin:0 0 4px;">→ {{ s.takeaway }}</div>
  {% endif %}
  {% endif %}
</div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{ subject }}</title>
  <style>
    @media (prefers-color-scheme: dark) {
      body, .page { background:#0e1013 !important; }
      .card { background:#15181d !important; border-color:#232830 !important; }
      .title, .gist, .points, .brand { color:#e6e8ec !important; }
      .byline, .quiet-link, .meta, .foot { color:#98a2b3 !important; }
      .item, .section-rule { border-color:#232830 !important; }
      .intro { color:#cbd2dc !important; border-color:#2b313a !important; }
      .section-label { color:#e6e8ec !important; }
      .dissent { background:#241d0f !important; border-color:#b45309 !important; color:#e3cfa4 !important; }
      .takeaway { color:#5eead4 !important; }
      a.title:hover { color:#93b4ff !important; }
    }
    @media only screen and (max-width:620px) {
      .card { padding:24px 18px !important; }
      .title { font-size:16px !important; }
    }
  </style>
</head>
<body class="page" style="margin:0;padding:0;background:{{ BODY_BG }};">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ items|length }} item{% if items|length != 1 %}s{% endif %}{% if intro %} · {{ intro[:90] }}{% endif %}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ BODY_BG }};padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;">
          <tr>
            <td class="card" style="background:{{ CARD_BG }};border:1px solid {{ RULE }};border-radius:10px;padding:32px 34px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:22px;">
                <tr>
                  <td class="brand" style="color:{{ INK }};font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;">ScrollLess</td>
                  <td class="meta" align="right" style="color:{{ MUTED }};font-size:12px;">{{ generated_at }}</td>
                </tr>
              </table>

              {% if intro %}
              <div class="intro" style="color:#3f4654;font-size:16px;line-height:1.65;border-left:3px solid {{ RULE }};padding-left:16px;margin:0 0 30px;">{{ intro }}</div>
              {% endif %}

              {% if not items %}
              <p class="gist" style="color:{{ INK }};font-size:16px;line-height:1.6;margin:0;">Nothing new today. Everything worth sending has already gone out this week.</p>
              {% endif %}

              {% if group_by_source %}
                {% for group_label, group_items in grouped %}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:28px 0 0;">
                  <tr>
                    <td class="section-label" style="color:{{ INK }};font-size:13px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;padding-bottom:2px;">{{ group_label }}</td>
                    <td class="meta" align="right" style="color:{{ MUTED }};font-size:12px;padding-bottom:2px;">{{ group_items|length }} item{% if group_items|length != 1 %}s{% endif %}</td>
                  </tr>
                </table>
                {% for item in group_items %}
                {{ item_block(item) }}
                {% endfor %}
                {% endfor %}
              {% else %}
                {% for item in items %}
                {{ item_block(item) }}
                {% endfor %}
              {% endif %}

              <div class="foot" style="color:{{ MUTED }};font-size:12px;line-height:1.6;border-top:1px solid {{ RULE }};margin-top:32px;padding-top:14px;">
                {{ items|length }} item{% if items|length != 1 %}s{% endif %} · ScrollLess
              </div>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
